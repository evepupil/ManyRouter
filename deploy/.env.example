MANYROUTER_OWNER_USERNAME=owner
MANYROUTER_OWNER_PASSWORD=replace_with_random_password
MANYROUTER_AUTH_COOKIE_SECURE=false
MANYROUTER_LOG_LEVEL=info

NEW_API_DB_ADMIN_USER=newapi_admin
NEW_API_DB_ADMIN_PASSWORD=replace_with_random_hex
NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi_app
NEW_API_DB_PASSWORD=replace_with_random_hex
NEW_API_LOG_DB_NAME=new_api_log
NEW_API_LOG_DB_USER=newapi_log
NEW_API_LOG_DB_PASSWORD=replace_with_random_hex
NEW_API_SESSION_SECRET=replace_with_random_token
NEW_API_OWNER_USERNAME=root
NEW_API_OWNER_PASSWORD=replace_with_random_password
NEW_API_SESSION_COOKIE_SECURE=false
MANYROUTER_SYNC_TOKEN=replace_with_random_token
MANYROUTER_SYNC_TOKEN_PREVIOUS=
