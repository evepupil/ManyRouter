COMPOSE_PROJECT_NAME=manyrouter-release
MANYROUTER_RELEASE_CHANNEL=local

POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
MANYROUTER_IMAGE=manyrouter-control:m4-local
MANYROUTER_BUILD_VERSION=m4-local
MANYROUTER_BUILD_COMMIT=unknown
